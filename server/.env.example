# AgroLoop Server Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agroloop?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Razorpay (Test Mode) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# ─── Email / SMTP ──────────────────────────────────────────────────────────────
# All SMTP variables are OPTIONAL. If not set, email sending is skipped
# and the email content is printed to the console in development mode.
#
# Option A — Gmail (free, requires 2FA + App Password)
#   1. Enable 2FA on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate a 16-character app password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=AgroLoop <your@gmail.com>
#
# Option B — Resend (recommended for production — free tier: 100 emails/day)
#   Get API key at https://resend.com
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=AgroLoop <noreply@yourdomain.com>
#
# Option C — SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=AgroLoop <noreply@yourdomain.com>
#
# Frontend URL for email links (defaults to CLIENT_URL if not set):
# CLIENT_RESET_URL=https://agroloop.vercel.app


# ─── Client URL (for CORS) ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Whitespace around commas is
# ignored. Localhost variants (5173, 3000) are always allowed automatically.
#
# Development (single origin):
CLIENT_URL=http://localhost:5173
#
# Production + preview deployments (multi-origin):
# CLIENT_URL=http://localhost:5173,https://agroloop.vercel.app,https://agroloop-git-main-yourteam.vercel.app
#
# Render backend deployment tip:
#   Set this env var in the Render dashboard → Environment → Add Variable.
#   Use a comma-separated string with NO spaces around commas if the dashboard
#   trims values, or wrap it in quotes if using a .env file on the server.

# ─── Observability (all optional — app works without them) ────────────────────

# Sentry error tracking (get DSN from https://sentry.io → Project Settings → DSN)
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project-id>

# Redis-backed rate limiting (recommended for multi-instance / horizontal scaling)
# Option A — Upstash (free tier at https://console.upstash.com, works on Render/Vercel)
# UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>
#
# Option B — Standard Redis (self-hosted / Redis Cloud)
# REDIS_URL=redis://:<password>@<host>:<port>
#
# If neither is set, the in-memory rate-limit store is used automatically.
# This is the original behaviour and works fine for single-process deployments.

