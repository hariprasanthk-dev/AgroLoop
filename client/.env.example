# AgroLoop Client Environment Variables
# Copy this file to .env and fill in your values

# ─── API ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api

# ─── Observability (optional — app works without them) ────────────────────────

# Sentry frontend error tracking
# Get your DSN from https://sentry.io → Project Settings → Client Keys (DSN)
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project-id>

# Application version reported to Sentry releases (optional)
# VITE_APP_VERSION=1.0.0
